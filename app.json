{
  "expo": {
    "name": "Thump",
    "slug": "thump-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "thumpmobile",
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.mdaffanasghar.thumpmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/favicon.png",
          "imageWidth": 46
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4baa4438-430a-40c2-a50a-6bcad92ef408"
      }
    }
  }
}
